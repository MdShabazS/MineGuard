{
  "name": "mineguard-digital-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MineGuard V0.1 Red/Blue digital twin (educational simulator, not real mine detection)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c red,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test server/test/*.test.ts",
    "task-gate": "node scripts/task-gate.mjs",
    "test:e2e": "tsx --test --test-concurrency=1 tests/e2e/*.e2e.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.170.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
